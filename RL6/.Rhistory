# Дескриптивный анализ для мужчин
plot_pair("Age", "Возраст", "лет", age_lim, weightlifting_men, "тяжёлая атлетика (мужчины)", "M")
plot_pair("Height", "Рост", "см", height_lim, weightlifting_men, "тяжёлая атлетика (мужчины)", "M")
plot_pair("Weight", "Вес", "кг", weight_lim, weightlifting_men, "тяжёлая атлетика (мужчины)", "M")
cat("Мужчины:\n")
print(summary(men[, c("Age", "Height", "Weight")]))
# Дескриптивный анализ для женщин
plot_pair("Age", "Возраст", "лет", age_lim, weightlifting_women, "тяжёлая атлетика (женщины)", "F")
plot_pair("Height", "Рост", "см", height_lim, weightlifting_women, "тяжёлая атлетика (женщины)", "F")
plot_pair("Weight", "Вес", "кг", weight_lim, weightlifting_women, "тяжёлая атлетика (женщины)", "F")
cat("\nЖенщины:\n")
print(summary(women[, c("Age", "Height", "Weight")]))
# Проверка нормальности распределения веса (мужчины)
cat("\nShapiro-Wilk Test (вес мужчин - тяжёлая атлетика):\n")
shapiro.test(na.omit(weightlifting_men$Weight))
qqPlot(na.omit(weightlifting_men$Weight), main="QQ Plot: вес мужчин")
# Проверка нормальности распределения веса (женщины)
cat("\nShapiro-Wilk Test (вес женщин - тяжёлая атлетика):\n")
shapiro.test(na.omit(weightlifting_women$Weight))
qqPlot(na.omit(weightlifting_women$Weight), main="QQ Plot: вес женщин")
# Проверка равенства дисперсий между мужчинами и женщинами в тяжёлой атлетике
weights_df <- data.frame(
Weight = c(weightlifting_men$Weight, weightlifting_women$Weight),
Sex = c(rep("M", nrow(weightlifting_men)), rep("F", nrow(weightlifting_women)))
)
weights_df <- na.omit(weights_df)
cat("\nBartlett test (вес мужчин и женщин):\n")
bartlett.test(Weight ~ Sex, data = weights_df)
# Проверка гипотезы о равенстве среднего веса между мужчинами и женщинами
cat("\nT-test (вес мужчин и женщин):\n")
t.test(Weight ~ Sex, data = weights_df)
# Проверка нормальности распределения веса (мужчины)
cat("\nShapiro-Wilk Test (вес мужчин):\n")
shapiro.test(na.omit(men$Weight))
qqPlot(rnorm(100,0,1))
weightlifting_men[824]
weightlifting_men$ID == 824
weights <- na.omit(weightlifting_men$Weight)
weights[c(824, 363)]
weights <- na.omit(weightlifting_women$Weight)
weights[c(136, 168)]
# Проверка гипотезы о среднем весе тяжелоатлетов
# Среднее по выборке
mean_weight <- mean(weightlifting_men$Weight)
t.test(weightlifting_men$Weight, mu = 80)
# Если распределение не нормальное — используем непараметрический тест
wilcox.test(weightlifting_men$Weight, mu = 80)
# Если распределение не нормальное — используем непараметрический тест
wilcox.test(weightlifting_men$Weight, mu = 70)
mean_weight
mean_weight
weights_men
# Среднее по выборке
mean_weight <- mean(weightlifting_men$Weight, na.rm = TRUE)
mean_weight
wilcox.test(weights_men, mu = 79)
weights_men <- na.omit(weightlifting_men$Weight)
wilcox.test(weights_men, mu = 79)
# Если распределение не нормальное — используем непараметрический тест
wilcox.test(weights_men, mu = 79.56991)
# Выборка мужчин-регбистов
rugby_men <- data[data$Sport == "Rugby" & data$Sex == "M" & !is.na(data$Weight), ]
rugby_weights <- rugby_men$Weight
# Сравнение дисперсий (проверка на гомоскедастичность)
bartlett.test(list(weights_men, rugby_weights))
wilcox.test(weights_men, rugby_weights)
cat("\nShapiro-Wilk Test (вес регбистов - тяжелая атлетика):\n")
shapiro.test(na.omit(rugby_weights))
qqPlot(na.omit(rugby_weights), main="QQ Plot: вес женщин")
# Выборка мужчин-регбистов
rugby_men <- data[data$Sport == "Rugby" & data$Sex == "M" & !is.na(data$Weight), ]
rugby_weights <- rugby_men$Weight
# Проверка нормальности распределения веса (регбисты)
cat("\nShapiro-Wilk Test (вес регбистов - тяжелая атлетика):\n")
shapiro.test(rugby_weights)
qqPlot(rugby_weights, main="QQ Plot: вес регбистов")
# Сравнение дисперсий (проверка на гомоскедастичность)
bartlett.test(list(weights_men, rugby_weights))
